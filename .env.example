# Copie ce fichier en .env.local pour le développement.
# En production, renseigne ces variables dans hPanel > Web Apps > ton app > Variables d'environnement.
# Aucune de ces valeurs ne doit être commitée.

# URL publique canonique (avec la cédille, encodée automatiquement)
NEXT_PUBLIC_SITE_URL=https://çavote.fr

# --- Newsletter (Resend) ---
# Clé API Resend avec droit d'envoi + gestion des contacts
RESEND_API_KEY=
# Expéditeur vérifié dans Resend (domaine çavote.fr = xn--avote-xra.fr à vérifier côté DNS)
RESEND_FROM="Ça vote ? <citoyen@xn--avote-xra.fr>"
# Identifiant du segment (ex-audience) dans lequel ajouter les inscrits confirmés
RESEND_SEGMENT_ID=
# Secret aléatoire de 32 caractères minimum (lettres et chiffres)
# Sert à chiffrer (AES-256-GCM) le lien de confirmation. Ne jamais le réutiliser ailleurs.
NEWSLETTER_SECRET=

# --- Tiquiz (facultatif) ---
# URL publique du quiz Tiquiz à afficher sur /quiz (voir docs/TIQUIZ.md)
NEXT_PUBLIC_TIQUIZ_URL=
